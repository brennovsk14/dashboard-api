{
  "info": {
    "name": "Dashboard API",
    "description": "Testes dos endpoints do dashboard.api: as 3 tabelas fixas de leitura (vendas mensais, vendas por região e pedidos) e o upload genérico de planilhas .xlsx.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "planilhaUuid",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Vendas Mensais",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/vendas-mensais/get?pagina=1&page-size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vendas-mensais",
            "get"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page-size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Headers de paginação presentes\", () => {",
              "    pm.response.to.have.header(\"x-total-content\");",
              "    pm.response.to.have.header(\"x-total-pages\");",
              "    pm.response.to.have.header(\"x-pagina-atual\");",
              "});",
              "",
              "pm.test(\"Total de registros é 12 (um por mês)\", () => {",
              "    pm.expect(pm.response.headers.get(\"x-total-content\")).to.eql(\"12\");",
              "});",
              "",
              "pm.test(\"Body é um array com os campos esperados\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "    if (json.length > 0) {",
              "        pm.expect(json[0]).to.have.all.keys(",
              "            \"uuid\", \"mes\", \"eletronicos\", \"vestuario\", \"alimentos\", \"livros\"",
              "        );",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Vendas por Região",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/vendas-por-regiao/get?pagina=1&page-size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vendas-por-regiao",
            "get"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page-size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Headers de paginação presentes\", () => {",
              "    pm.response.to.have.header(\"x-total-content\");",
              "    pm.response.to.have.header(\"x-total-pages\");",
              "    pm.response.to.have.header(\"x-pagina-atual\");",
              "});",
              "",
              "pm.test(\"Total de registros é 5 (uma por região)\", () => {",
              "    pm.expect(pm.response.headers.get(\"x-total-content\")).to.eql(\"5\");",
              "});",
              "",
              "pm.test(\"Body é um array com os campos esperados\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "    if (json.length > 0) {",
              "        pm.expect(json[0]).to.have.all.keys(",
              "            \"uuid\", \"regiao\", \"clientes\", \"pedidos\", \"receita\", \"ticketMedio\", \"satisfacao\"",
              "        );",
              "    }",
              "});",
              "",
              "pm.test(\"Satisfação está sempre entre 0 e 10\", () => {",
              "    const json = pm.response.json();",
              "    json.forEach(r => {",
              "        pm.expect(r.satisfacao).to.be.at.least(0).and.at.most(10);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pedidos/get?pagina=1&page-size=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "get"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page-size",
              "value": "50"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Headers de paginação presentes\", () => {",
              "    pm.response.to.have.header(\"x-total-content\");",
              "    pm.response.to.have.header(\"x-total-pages\");",
              "    pm.response.to.have.header(\"x-pagina-atual\");",
              "});",
              "",
              "pm.test(\"Total de registros é 300\", () => {",
              "    pm.expect(pm.response.headers.get(\"x-total-content\")).to.eql(\"300\");",
              "});",
              "",
              "pm.test(\"Respeita o page-size pedido (50)\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.length).to.eql(50);",
              "});",
              "",
              "pm.test(\"Body tem os campos esperados\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json[0]).to.have.all.keys(",
              "        \"uuid\", \"data\", \"regiao\", \"categoria\", \"quantidade\",",
              "        \"valorUnitario\", \"valorTotal\", \"avaliacao\"",
              "    );",
              "});",
              "",
              "pm.test(\"Avaliação está sempre entre 1 e 5\", () => {",
              "    const json = pm.response.json();",
              "    json.forEach(p => {",
              "        pm.expect(p.avaliacao).to.be.at.least(1).and.at.most(5);",
              "    });",
              "});",
              "",
              "pm.test(\"valorTotal bate com quantidade * valorUnitario\", () => {",
              "    const json = pm.response.json();",
              "    json.forEach(p => {",
              "        const esperado = Math.round(p.quantidade * p.valorUnitario * 100) / 100;",
              "        pm.expect(Math.abs(p.valorTotal - esperado)).to.be.below(0.02);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Planilhas - Upload",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/planilhas/post?nome=Minha Planilha",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "planilhas",
            "post"
          ],
          "query": [
            {
              "key": "nome",
              "value": "Minha Planilha"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "arquivo",
              "type": "file",
              "description": "Selecione um arquivo .xlsx antes de enviar",
              "src": []
            }
          ]
        },
        "description": "Envia um .xlsx. O backend le a PRIMEIRA aba, usa a primeira linha como cabecalho e converte as demais em JSON. Guarda o uuid retornado na variavel {{planilhaUuid}}."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "",
              "pm.test(\"Retorna uuid e nome\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.all.keys(\"uuid\", \"nome\");",
              "    pm.expect(json.uuid).to.match(/^[0-9a-f-]{36}$/);",
              "});",
              "",
              "// guarda o uuid para a request de detalhe",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"planilhaUuid\", pm.response.json().uuid);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Planilhas - Listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/planilhas/get?pagina=1&page-size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "planilhas",
            "get"
          ],
          "query": [
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "page-size",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Headers de paginacao presentes\", () => {",
              "    pm.response.to.have.header(\"x-total-content\");",
              "    pm.response.to.have.header(\"x-total-pages\");",
              "    pm.response.to.have.header(\"x-pagina-atual\");",
              "});",
              "",
              "pm.test(\"Listagem NAO traz o conteudo (campo valor)\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an(\"array\");",
              "    json.forEach(p => pm.expect(p).to.have.all.keys(\"uuid\", \"nome\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Planilhas - Buscar por UUID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/planilhas/{{planilhaUuid}}/get",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "planilhas",
            "{{planilhaUuid}}",
            "get"
          ]
        },
        "description": "Usa o uuid capturado pela request de upload. Rode 'Planilhas - Upload' antes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "",
              "pm.test(\"Retorna uuid, nome e valor\", () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.all.keys(\"uuid\", \"nome\", \"valor\");",
              "});",
              "",
              "pm.test(\"valor e uma string JSON parseavel, com array de objetos\", () => {",
              "    const linhas = JSON.parse(pm.response.json().valor);",
              "    pm.expect(linhas).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(linhas[0]).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"Todas as linhas tem as mesmas colunas, na mesma ordem\", () => {",
              "    const linhas = JSON.parse(pm.response.json().valor);",
              "    const referencia = JSON.stringify(Object.keys(linhas[0]));",
              "    linhas.forEach(l => pm.expect(JSON.stringify(Object.keys(l))).to.eql(referencia));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
